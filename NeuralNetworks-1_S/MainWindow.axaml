<Window x:Class="NeuralNetworks_1.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeuralNetworks_1"
        mc:Ignorable="d"
        Title="Neural Networks - Lab 3"
        Width="1550"
        Height="980">

    <Grid ColumnDefinitions="4*,1.45*"
          Margin="10">

        <!-- DATAGRID -->

        <Border Grid.Column="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0,0,10,0">

            <DataGrid x:Name="networkDataGrid"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="All">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="InputLayer"
                        Width="95"
                        Binding="{Binding inputValue}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="WeightsIH"
                        Width="130"
                        Binding="{Binding weightsIH}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="InputHidden"
                        Width="120"
                        Binding="{Binding inputHidden}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="OutputHidden"
                        Width="120"
                        Binding="{Binding outputHidden}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="WeightsH-O"
                        Width="130"
                        Binding="{Binding weightsHO}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="ErrorHidden"
                        Width="110"
                        Binding="{Binding errorHidden}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="InputOutput"
                        Width="110"
                        Binding="{Binding inputOutput}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="OutputLayer"
                        Width="110"
                        Binding="{Binding outputLayer}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="Target"
                        Width="90"
                        Binding="{Binding target}"
                        x:DataType="local:nodeRow"/>

                    <DataGridTextColumn
                        Header="ErrorOutput"
                        Width="110"
                        Binding="{Binding errorOutput}"
                        x:DataType="local:nodeRow"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- RECHTS -->

        <ScrollViewer Grid.Column="1">

            <StackPanel Spacing="14">

                <!-- NETWORK SETUP -->

                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Network Setup"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="8"
                              ColumnSpacing="10">

                            <TextBlock Grid.Row="0"
                                       Text="Learning Rate"/>

                            <TextBox x:Name="learningRateTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Text="0.3"/>


                            <TextBlock Grid.Row="1"
                                       Text="Input Nodes"/>

                            <TextBox x:Name="inputTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Text="784"/>


                            <TextBlock Grid.Row="2"
                                       Text="Hidden Nodes"/>

                            <TextBox x:Name="hiddenTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Text="100"/>


                            <TextBlock Grid.Row="3"
                                       Text="Output Nodes"/>

                            <TextBox x:Name="outputTextBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Text="10"/>

                        </Grid>


                        <Button x:Name="createButton"
                                Content="Create Network"
                                Height="38"
                                Click="createButton_Click"/>

                    </StackPanel>

                </Border>


                <!-- TRAINING -->

                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Training"
                                   FontWeight="Bold"
                                   FontSize="16"/>


                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">

                            <TextBlock Text="Epochen"/>

                            <TextBox x:Name="epochsTextBox"
                                     Grid.Column="1"
                                     Text="1"/>

                        </Grid>


                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">

                            <Button x:Name="openTrainingFileButton"
                                    Grid.Column="0"
                                    Content="Open Training File"
                                    Click="openTrainingFileButton_Click"/>

                            <Button x:Name="trainButton"
                                    Grid.Column="1"
                                    Content="Train Network"
                                    IsEnabled="False"
                                    Click="trainButton_Click"/>

                        </Grid>


                        <Button x:Name="loadWeightMatricesButton"
                                Content="Load Weight Matrices"
                                Click="loadWeightMatricesButton_Click"/>

                    </StackPanel>

                </Border>


                <!-- TESTING -->

                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Testing"
                                   FontWeight="Bold"
                                   FontSize="16"/>


                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">

                            <Button x:Name="openTestFileButton"
                                    Grid.Column="0"
                                    Content="Open Test File"
                                    Click="openTestFileButton_Click"/>

                            <Button x:Name="queryButton"
                                    Grid.Column="1"
                                    Content="Query Network"
                                    IsEnabled="False"
                                    Click="queryButton_Click"/>

                        </Grid>


                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">

                            <TextBlock Text="Performance"/>

                            <TextBox x:Name="performanceTextBox"
                                     Grid.Column="1"
                                     Text="0"
                                     IsReadOnly="True"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- IMAGE -->

                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="12">

                    <StackPanel Spacing="10">

                        <TextBlock Text="Image"
                                   FontWeight="Bold"
                                   FontSize="16"/>


                        <Grid ColumnDefinitions="180,*"
                              ColumnSpacing="16">

                            <Border Grid.Column="0"
                                    Width="180"
                                    Height="180"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Background="Black">

                                <Grid>

                                    <Image x:Name="numberImage"
                                           Stretch="Uniform"/>

                                    <TextBlock x:Name="noImageTextBlock"
                                               Text="no image"
                                               Foreground="Gray"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        Spacing="15">

                                <CheckBox x:Name="checkBoxImage"
                                          Content="Show Images"/>

                                <TextBlock Text="Recognized"/>

                                <TextBox x:Name="recognizedTextBox"
                                         Text="?"
                                         IsReadOnly="True"
                                         FontSize="28"
                                         FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <TextBlock x:Name="statusTextBlock"
                           Text="Ready."
                           TextWrapping="Wrap"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>